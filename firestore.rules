rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Allow read to authenticated users (searching by phone number or linking code, viewing profiles)
      allow read: if isAuthenticated();

      // Allow users to create their own profile document
      allow create: if isOwner(userId);

      // Allow updates if:
      // 1. User owns the document (updating profile, generating linking code, etc.)
      // 2. Guardian linking flow (setting linkedGuardianId and clearing linkingCode)
      // 3. Linked guardian modifying senior document (e.g. adding funds)
      // 4. Wallet balance updates by authenticated users
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedGuardianId', 'linkingCode']) ||
        resource.data.get('linkedGuardianId', null) == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance'])
      );

      // Allow users to delete their own profile
      allow delete: if isOwner(userId);
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Allow authenticated users to read and write transactions
      allow read, write: if isAuthenticated();
    }

    // Deny access to all other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
