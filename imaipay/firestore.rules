rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Transactions collection
    match /transactions/{transactionId} {

      // Anyone can create a transaction (since we use mock auth, no real uid check)
      allow create: if request.resource.data.keys().hasAll(['senderId', 'receiverName', 'amount', 'status', 'createdAt'])
                    && request.resource.data.status in ['in_escrow', 'pending_guardian'];

      // Only the sender can read their own transactions
      allow read: if resource.data.senderId == request.auth.uid
                  || true; // Fallback for mock auth — remove 'true' when real auth is added

      // Sender can cancel their own transaction
      // Guardian can approve (move to in_escrow) a pending_guardian transaction
      allow update: if (request.resource.data.status == 'cancelled' && resource.data.senderId == resource.data.senderId)
                    || (request.resource.data.status == 'in_escrow' && resource.data.status == 'pending_guardian')
                    || true; // Fallback for mock auth — remove 'true' when real auth is added

      allow delete: if false; // Never allow deletion
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
